<%= form_with url: login_path, method: :post, local: true do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.text_field :email, name: 'session[email]' %>
  </div>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password, name: 'session[password]' %>
  </div>
  <%= form.submit "Log in" %>
<% end %>
