<div class="container mt-4">
  <h1 class="mb-4 text-center">Courses</h1>

<%= form_with url: courses_path, method: :get, local: true do |form| %>
  <div>
    <%= form.label :query, "Search Golf Courses" %>
    <%= form.text_field :query, placeholder: "Enter course name" %>
  </div>
  <%= form.submit "Search" %>
<% end %>

<% if @results.present? %>
  <h2>Search Results:</h2>
  <ul>
    <% @results.each do |course| %>
      <li><strong><%= course["name"] %></strong> - <%= course["location"] %></li>
    <% end %>
  </ul>
<% elsif params[:query].present? %>
  <p>No courses found for "<%= params[:query] %>".</p>
<% end %>

<h2>All Courses</h2>

  <div class="row">
    <% @courses.each do |course| %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-lg">
          <div class="card-body">
            <h5 class="card-title"><%= course.name %></h5>
            <p class="card-text">
              <strong>Holes:</strong> <%= course.holes.count %>
              <br/>
              <strong>Par:</strong> <%= course.par %>
            </p>
            
            <div class="d-flex justify-content-between">
              <%= link_to "View", course_path(course), class: "btn btn-primary" %>
              <%= link_to "Edit", edit_course_path(course), class: "btn btn-secondary" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
