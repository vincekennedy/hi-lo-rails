<div class="container mt-4">
  <h1 class="text-center"><%= @course.name %></h1>

  <h3 class="mt-4">Holes</h3>

  <div class="row">
    <% [@course.holes.first(9), @course.holes.last(9)].each_with_index do |holes_group, row_index| %>
      <div class="col-12">
        <table class="table table-bordered text-center">
          <thead class="table-dark">
            <tr>
              <% holes_group.each do |hole| %>
                <th>Hole <%= hole.hole_number %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <tr>
              <% holes_group.each do |hole| %>
                <td>Par <%= hole.hole_par %></td>
              <% end %>
            </tr>
            <tr>
              <% holes_group.each do |hole| %>
                <td>HCP <%= hole.hole_handicap %></td>
              <% end %>
            </tr>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <%= link_to "Back to Courses", courses_path, class: "btn btn-secondary mt-3" %>
</div>
